<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cadastro — Humanize</title>
<meta name="description" content="Crie sua conta no Humanize e acompanhe seus resultados nos quizzes e jogos.">
<link rel="stylesheet" href="style.css">
<style>
  .form-shell{max-width:560px;margin:0 auto;}
  .form-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:36px;box-shadow:var(--shadow-soft);}
  .field{margin-bottom:20px;}
  .field label{display:block;font-size:.92rem;font-weight:600;margin-bottom:6px;color:var(--ink);}
  .field input[type="text"],
  .field input[type="email"],
  .field input[type="password"],
  .field input[type="date"],
  .field select{font:inherit;width:100%;padding:13px 14px;border:1.5px solid var(--line);border-radius:var(--radius-sm);background:#fff;color:var(--ink);transition:border-color .2s ease;}
  .field input:focus,
  .field select:focus{outline:none;border-color:var(--blue);}
  .field.has-error input,
  .field.has-error select{border-color:#D64545;}
  .field-hint{font-size:.8rem;color:var(--grey);margin-top:5px;}
  .field-error{display:none;font-size:.82rem;color:#B03030;margin-top:5px;}
  .field.has-error .field-error{display:block;}
  .row-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .pass-wrap{position:relative;}
  .pass-wrap input{padding-right:78px;}
  .pass-toggle{position:absolute;right:8px;top:50%;transform:translateY(-50%);font:inherit;font-size:.8rem;border:0;background:none;color:var(--blue-deep);cursor:pointer;padding:6px 8px;}
  .check-row{display:flex;gap:10px;align-items:flex-start;font-size:.9rem;margin-bottom:8px;}
  .check-row input{margin-top:4px;}
  .check-row a{color:var(--blue-deep);text-decoration:underline;}
  .form-actions{margin-top:24px;}
  .form-actions .btn{width:100%;}
  .form-foot{text-align:center;font-size:.9rem;margin-top:20px;color:var(--grey);}
  .form-foot a{color:var(--blue-deep);text-decoration:underline;}
  .success-box{text-align:center;padding:10px 0;}
  .success-box h2{font-size:1.4rem;margin-bottom:10px;}
  .success-box p{margin:0 auto 22px;}
  .form-note{font-size:.82rem;color:var(--grey);margin-top:30px;text-align:center;}
  [hidden]{display:none !important;}
  @media (max-width:520px){.row-2{grid-template-columns:1fr;}.form-card{padding:24px;}}
</style>
</head>
<body>

<a href="#main" class="skip-link">Pular para o conteúdo</a>

<header class="site-header">
  <div class="container">
    <a href="index.html" class="logo">Human<span>ize</span></a>
    <nav>
      <ul class="nav-links" id="nav-links">
        <li><a href="index.html#reflita">Reflita</a></li>
        <li><a href="quiz.html">Quiz</a></li>
        <li><a href="index.html#voce-sabia">Você sabia?</a></li>
        <li><a href="mito-ou-fato.html">Mito ou fato</a></li>
        <li><a href="linguagem-corporal.html">Linguagem corporal</a></li>
      </ul>
    </nav>
    <div class="nav-cta">
      <a href="index.html" class="btn btn-ghost">Voltar à home</a>
      <button class="menu-toggle" id="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<main id="main">
  <section class="section" style="padding-top:calc(var(--header-h) + 60px);">
    <div class="container form-shell">

      <div class="section-head">
        <span class="eyebrow">Cadastro</span>
        <h1 style="font-family:var(--font-head); font-size:clamp(1.7rem,3vw,2.3rem);">Crie sua conta</h1>
        <p>Preencha os dados abaixo para guardar seus resultados e voltar quando quiser.</p>
      </div>

      <div class="form-card" id="form-card">
        <form id="signup-form" novalidate>

          <div class="field" id="f-nome">
            <label for="nome">Nome completo</label>
            <input type="text" id="nome" name="nome" autocomplete="name">
            <div class="field-error">Digite seu nome e sobrenome.</div>
          </div>

          <div class="field" id="f-email">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" autocomplete="email">
            <div class="field-error">Digite um e-mail válido.</div>
          </div>

          <div class="row-2">
            <div class="field" id="f-nasc">
              <label for="nasc">Data de nascimento</label>
              <input type="date" id="nasc" name="nasc" autocomplete="bday">
              <div class="field-error">Informe sua data de nascimento.</div>
            </div>
            <div class="field" id="f-escola">
              <label for="escola">Você é</label>
              <select id="escola" name="escola">
                <option value="">Selecione</option>
                <option>Estudante</option>
                <option>Professor(a)</option>
                <option>Responsável</option>
                <option>Outro</option>
              </select>
              <div class="field-error">Escolha uma opção.</div>
            </div>
          </div>

          <div class="field" id="f-senha">
            <label for="senha">Senha</label>
            <div class="pass-wrap">
              <input type="password" id="senha" name="senha" autocomplete="new-password">
              <button type="button" class="pass-toggle" id="pass-toggle">Mostrar</button>
            </div>
            <div class="field-hint">Pelo menos 8 caracteres, com letras e números.</div>
            <div class="field-error" id="senha-erro">A senha precisa ter 8 caracteres ou mais, com letras e números.</div>
          </div>

          <div class="field" id="f-senha2">
            <label for="senha2">Confirmar senha</label>
            <input type="password" id="senha2" name="senha2" autocomplete="new-password">
            <div class="field-error">As senhas não são iguais.</div>
          </div>

          <div class="field" id="f-termos">
            <div class="check-row">
              <input type="checkbox" id="termos" name="termos">
              <label for="termos" style="font-weight:400;margin:0;">Li e concordo com os <a href="#">termos de uso</a>.</label>
            </div>
            <div class="field-error">Você precisa aceitar os termos para continuar.</div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Criar conta</button>
          </div>

          <p class="form-foot">Já tem conta? <a href="index.html">Entrar</a></p>
        </form>

        <div class="success-box" id="success" hidden>
          <span class="eyebrow">Tudo certo</span>
          <h2 id="success-title">Cadastro concluído!</h2>
          <p>Sua conta foi criada. Agora é só escolher por onde começar.</p>
          <a href="quiz.html" class="btn btn-primary">Fazer um quiz</a>
        </div>
      </div>

      <p class="form-note">Projeto de estudo: os dados deste formulário não são enviados nem guardados em nenhum servidor.</p>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="container footer-bottom" style="border-top:1px solid rgba(246,245,241,.12); padding-top:24px;">
    <span>© 2026 Humanize — Projeto final, Programador Web</span>
    <span>Entenda o que existe por trás do comportamento.</span>
  </div>
</footer>

<button class="back-to-top" id="back-to-top" aria-label="Voltar ao topo">↑</button>

<script src="script.js"></script>
<script>
(function () {
  var form = document.getElementById("signup-form");
  var $ = function (id) { return document.getElementById(id); };

  function setError(fieldId, hasError) {
    $(fieldId).classList.toggle("has-error", hasError);
    return !hasError;
  }

  function validate() {
    var ok = true;

    var nome = $("nome").value.trim();
    ok = setError("f-nome", nome.split(/\s+/).length < 2 || nome.length < 5) && ok;

    var email = $("email").value.trim();
    ok = setError("f-email", !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) && ok;

    var nasc = $("nasc").value;
    var dataOk = nasc !== "" && new Date(nasc) < new Date() && new Date(nasc).getFullYear() > 1900;
    ok = setError("f-nasc", !dataOk) && ok;

    ok = setError("f-escola", $("escola").value === "") && ok;

    var senha = $("senha").value;
    var senhaOk = senha.length >= 8 && /[A-Za-z]/.test(senha) && /\d/.test(senha);
    ok = setError("f-senha", !senhaOk) && ok;

    ok = setError("f-senha2", $("senha2").value !== senha || senha === "") && ok;

    ok = setError("f-termos", !$("termos").checked) && ok;

    return ok;
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    if (!validate()) {
      var first = form.querySelector(".has-error input, .has-error select");
      if (first) first.focus();
      return;
    }
    var primeiro = $("nome").value.trim().split(/\s+/)[0];
    $("success-title").textContent = "Bem-vindo(a), " + primeiro + "!";
    form.hidden = true;
    $("success").hidden = false;
  });

  form.querySelectorAll("input, select").forEach(function (el) {
    el.addEventListener("input", function () {
      var field = el.closest(".field");
      if (field && field.classList.contains("has-error")) field.classList.remove("has-error");
    });
  });

  $("pass-toggle").addEventListener("click", function () {
    var s = $("senha");
    var show = s.type === "password";
    s.type = show ? "text" : "password";
    this.textContent = show ? "Ocultar" : "Mostrar";
  });
})();
</script>
</body>
</html>